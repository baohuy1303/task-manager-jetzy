### Organization Suspension Test Suite
@baseUrl = http://localhost:3000/api/v1
@password = password123

### 1. Setup Admin
# @name adminSetup
POST {{baseUrl}}/users
Content-Type: application/json

{
    "name": "Suspend Admin",
    "email": "suspend_admin@test.com",
    "password": "{{password}}",
    "role": "admin"
}

###
@adminId = {{adminSetup.response.body.data.id}}

### 2. Login Admin & Create Org
# @name adminLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "suspend_admin@test.com",
    "password": "{{password}}"
}

###
@adminToken = {{adminLogin.response.body.data.token}}

# @name createOrg
POST {{baseUrl}}/organizations
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
    "name": "Org to Suspend"
}

###
@orgId = {{createOrg.response.body.data.id}}

### 3. Re-Login Admin (Refresh Token with OrgId)
# @name adminReLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "suspend_admin@test.com",
    "password": "{{password}}"
}

###
@adminToken = {{adminReLogin.response.body.data.token}}

### 4. Create Member
# @name memberSetup
POST {{baseUrl}}/users
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
    "organization_id": "{{orgId}}",
    "name": "Suspend Member",
    "email": "suspend_member@test.com",
    "password": "{{password}}",
    "role": "member"
}

###
@memberId = {{memberSetup.response.body.data.id}}

### 5. Login Member (Should WORK initially)
# @name memberLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "suspend_member@test.com",
    "password": "{{password}}"
}

###
@memberToken = {{memberLogin.response.body.data.token}}

### 6. Verify Member Can Access Projects (Initial)
GET {{baseUrl}}/projects
Authorization: Bearer {{memberToken}}

### 7. ACTION: Suspend Organization (Admin)
PATCH {{baseUrl}}/organizations/{{orgId}}/suspend
Authorization: Bearer {{adminToken}}

### 8. VERIFY: Member Login (Should FAIL - 403 Forbidden)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "suspend_member@test.com",
    "password": "{{password}}"
}

### 9. VERIFY: Member Access with EXISTING Token (Should FAIL - 403 Forbidden)
# This tests the Real-Time Middleware check
GET {{baseUrl}}/projects
Authorization: Bearer {{memberToken}}

### 10. VERIFY: Admin Login (Should SUCCEED)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "suspend_admin@test.com",
    "password": "{{password}}"
}

### 11. VERIFY: Admin Access (Should SUCCEED)
GET {{baseUrl}}/projects
Authorization: Bearer {{adminToken}}

### 12. ACTION: Activate Organization (Admin)
PATCH {{baseUrl}}/organizations/{{orgId}}/activate
Authorization: Bearer {{adminToken}}

### 13. VERIFY: Member Login (Should SUCCEED Again)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "suspend_member@test.com",
    "password": "{{password}}"
}
