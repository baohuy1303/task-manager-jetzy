### GET /projects - Admin gets all projects
# @name getProjects
GET {{baseUrl}}/projects
Authorization: Bearer {{adminToken}}

###
@projectId = {{getProjects.response.body.data[0].id}}

### GET /projects - With pagination P1
# @name getProjectsP1
GET {{baseUrl}}/projects?limit=1
Authorization: Bearer {{adminToken}}

###
@cursor1 = {{getProjectsP1.response.body.meta.next_cursor}}

### GET /projects - With pagination P2
# @name getProjectsP2
GET {{baseUrl}}/projects?limit=1&cursor={{cursor1}}
Authorization: Bearer {{adminToken}}

###
@cursor2 = {{getProjectsP2.response.body.meta.next_cursor}}

### GET /projects - With pagination P3
# @name getProjectsP3
GET {{baseUrl}}/projects?limit=1&cursor={{cursor2}}
Authorization: Bearer {{adminToken}}

### GET /projects - With filters
GET {{baseUrl}}/projects?status=active&search=Test
Authorization: Bearer {{adminToken}}

### GET /projects - Member gets assigned projects
GET {{baseUrl}}/projects
Authorization: Bearer {{memberToken}}

### GET /projects/:id - Admin gets project
GET {{baseUrl}}/projects/{{projectId}}
Authorization: Bearer {{adminToken}}

### GET /projects/:id - Member gets assigned project
GET {{baseUrl}}/projects/{{projectId}}
Authorization: Bearer {{memberToken}}

### GET /projects/:id - Invalid ID
GET {{baseUrl}}/projects/invalid-id
Authorization: Bearer {{adminToken}}

