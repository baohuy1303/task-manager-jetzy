### Variables
@baseUrl = http://localhost:3000/api/v1
@adminToken = {{adminLogin.response.body.data.token}}
@managerToken = {{managerLogin.response.body.data.token}}
@memberToken = {{memberLogin.response.body.data.token}}
@adminUserId = {{adminLogin.response.body.data.user.id}}
@managerUserId = {{managerLogin.response.body.data.user.id}}
@memberUserId = {{memberLogin.response.body.data.user.id}}
@orgId = {{createOrganization.response.body.data.id}}
@projectId = {{createProject.response.body.data.id}}
@taskId = {{createTask.response.body.data.id}}
@memberUserId = {{createMemberUser.response.body.data.id}}

### 1️⃣ AUTHENTICATION

### POST /user/register
POST {{baseUrl}}/users
Content-Type: application/json

