  "email": "manager@example.com",
  "password": "manager123",
  "organization_id": "{{orgId}}",
  "name": "Manager",
  "role": "manager"
}

### POST /user/register
POST {{baseUrl}}/users
Content-Type: application/json

{
  "email": "member@example.com",
  "password": "member123",
  "organization_id": "{{orgId}}",
  "name": "Member",
  "role": "member"
}

