### 2️⃣ ORGANIZATIONS

### POST /organizations - Admin creates organization
# @name createOrganization
POST {{baseUrl}}/organizations
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Test Organization"
}

### POST /organizations - Manager attempts to create (should fail)
POST {{baseUrl}}/organizations
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
  "name": "Manager Created Org",
  "description": "This should fail"
}

### POST /organizations - Duplicate name
POST {{baseUrl}}/organizations
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Test Organization"
}

### POST /auth/login - Admin login to get org id again
# @name adminLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@example.com",
  "password": "admin123"
}

###
@orgId = {{adminLogin.response.body.data.user.organization_id}}

### GET /organizations/:id - Fetch own organization
GET {{baseUrl}}/organizations/{{orgId}}
Authorization: Bearer {{adminToken}}

### GET /organizations/:id - Fetch another organization (should fail)
GET {{baseUrl}}/organizations/12345678-1234-1234-1234-123456789abc
Authorization: Bearer {{adminToken}}

### GET /organizations/:id - Invalid UUID
GET {{baseUrl}}/organizations/invalid-uuid
Authorization: Bearer {{adminToken}}

### PATCH /organizations/:id/suspend - Admin suspends organization
PATCH {{baseUrl}}/organizations/{{orgId}}/suspend
Authorization: Bearer {{adminToken}}

### PATCH /organizations/:id/activate - Admin activates organization
PATCH {{baseUrl}}/organizations/{{orgId}}/activate
Authorization: Bearer {{adminToken}}

