### Jetzy Task Manager - End-to-End Functional Test Suite
# Use with VS Code "REST Client" extension

@baseUrl = http://localhost:3000/api/v1

### ------------------------------------------------------------
### FLOW 1: ADMIN - Onboarding & Setup
### ------------------------------------------------------------

### A1. Admin Sign Up (Public - Org-less)
# @name adminSignUp
POST {{baseUrl}}/users
Content-Type: application/json

{
    "name": "Super Admin",
    "email": "master-admin@jetzy.com",
    "password": "password123",
    "role": "admin"
}

### Capture Admin ID
@adminId = {{adminSignUp.response.body.data.id}}

### A2. Admin Login
# @name adminLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "master-admin@jetzy.com",
    "password": "password123"
}

### Capture Admin Token
@adminToken = {{adminLogin.response.body.data.token}}

### A3. Admin Creates Organization
# @name createOrg
POST {{baseUrl}}/organizations
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
    "name": "Jetzy Engineering"
}

### Capture Org ID
@orgId = {{createOrg.response.body.data.id}}

### A4. Admin Links Self to the Organization
PATCH {{baseUrl}}/users/{{adminId}}/organization
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
    "organization_id": "{{orgId}}"
}

### A5. Admin Creates a Manager
# @name createManager
POST {{baseUrl}}/users
Content-Type: application/json

{
    "organization_id": "{{orgId}}",
    "name": "Manager Bob",
    "email": "bob-manager@jetzy.com",
    "password": "password123",
    "role": "manager"
}

### A6. Admin Creates a Member
# @name createMember
POST {{baseUrl}}/users
Content-Type: application/json

{
    "organization_id": "{{orgId}}",
    "name": "Member Alice",
    "email": "alice-member@jetzy.com",
    "password": "password123",
    "role": "member"
}

### Capture Member ID
@memberId = {{createMember.response.body.data.id}}


### ------------------------------------------------------------
### FLOW 2: MANAGER - Projects & Tasks
### ------------------------------------------------------------

### M1. Manager Login
# @name managerLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "bob-manager@jetzy.com",
    "password": "password123"
}

### Capture Manager Token
@managerToken = {{managerLogin.response.body.data.token}}

### M2. Manager Creates a Project
# @name createProject
POST {{baseUrl}}/projects
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
    "name": "Project Apollo",
    "description": "Moon landing project",
    "status": "active"
}

### Capture Project ID
@projectId = {{createProject.response.body.data.id}}

### M3. Manager Assigns the Member to this Project (The "One Project" Rule)
PATCH {{baseUrl}}/users/{{memberId}}/project
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
    "project_id": "{{projectId}}"
}

### M4. Manager Creates and Assigns a Task
# @name createTask
POST {{baseUrl}}/tasks
Authorization: Bearer {{managerToken}}
Content-Type: application/json

{
    "project_id": "{{projectId}}",
    "title": "Build the Rocket",
    "description": "Assemble the main booster engines",
    "priority": "urgent",
    "assigned_to": "{{memberId}}"
}

### Capture Task ID
@taskId = {{createTask.response.body.data.id}}


### ------------------------------------------------------------
### FLOW 3: MEMBER - Scoped Execution
### ------------------------------------------------------------

### B1. Member Login
# @name memberLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "alice-member@jetzy.com",
    "password": "password123"
}

### Capture Member Token
@memberToken = {{memberLogin.response.body.data.token}}

### B2. Member Sees ONLY their assigned project
GET {{baseUrl}}/projects
Authorization: Bearer {{memberToken}}

### B3. Member Sees ONLY their assigned tasks
GET {{baseUrl}}/tasks?project_id={{projectId}}
Authorization: Bearer {{memberToken}}

### B4. Member Successfully Updates Task Status
PATCH {{baseUrl}}/tasks/{{taskId}}/status
Authorization: Bearer {{memberToken}}
Content-Type: application/json

{
    "status": "in_progress"
}

### B5. Member TRIES to update Task Title (Should fail - Input Validation blocks this)
# Members only have 'status' in their update schema
PATCH {{baseUrl}}/tasks/{{taskId}}/status
Authorization: Bearer {{memberToken}}
Content-Type: application/json

{
    "title": "Hack the Rocket"
}
