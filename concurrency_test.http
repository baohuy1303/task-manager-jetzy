@baseUrl = http://localhost:3000/api/v1
@password = password123

### 1a. Login Admin
# @name loginAdmin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin_test@test2.com",
  "password": "{{password}}"
}

###
@adminToken = {{loginAdmin.response.body.data.token}}
@adminOrgId = {{loginAdmin.response.body.data.user.organization_id}}

### 2a. Create Project
# @name createConcProject
POST {{baseUrl}}/projects
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "name": "Concurrency Project 1",
  "description": "Test Project for concurrency"
}

###
@projectId = {{createConcProject.response.body.data.id}}

### 2b. Create Task
# @name createTask
POST {{baseUrl}}/tasks
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "title": "Race Condition Task 1",
  "project_id": "{{projectId}}"
}

###
@taskId = {{createTask.response.body.data.id}}
@initialVersion = {{createTask.response.body.data.version}}

### 3a. User 1: Update Task (Success) -> Version 2
# @name user1Update
PATCH {{baseUrl}}/tasks/{{taskId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "title": "Updated by User 1",
  "version": {{initialVersion}}
}

###
@v2 = {{user1Update.response.body.data.version}}

### 3b. User 2: Update Task with OLD version -> Conflict
# Expected: 409 Conflict
PATCH {{baseUrl}}/tasks/{{taskId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "title": "Updated by User 2 (Stale)",
  "version": {{initialVersion}}
}

### 3c. User 2: Update Status with OLD version -> Conflict
# Expected: 409 Conflict
PATCH {{baseUrl}}/tasks/{{taskId}}/status
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "status": "in_progress",
  "version": {{initialVersion}}
}

### 3d. User 2: Update Task with NEW version -> Success
# Expected: Success -> Version 3
PATCH {{baseUrl}}/tasks/{{taskId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "title": "Updated by User 2 (Fresh)",
  "version": {{v2}}
}

### 4. Member Concurrency Test
# 4a. Create Member
# @name createMember
POST {{baseUrl}}/users
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
    "name": "Conc Member",
    "email": "conc_member@test.com",
    "organization_id": "{{adminOrgId}}",
    "password": "{{password}}",
    "role": "member"
}

###
@memberId = {{createMember.response.body.data.id}}

# 4b. Assign Member to Project
PATCH {{baseUrl}}/users/{{memberId}}/project
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
    "project_id": "{{projectId}}",
    "action": "assign"
}

###
# 4c. Login Member
# @name loginMember
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "conc_member@test.com",
  "password": "{{password}}"
}

###
@memberToken = {{loginMember.response.body.data.token}}

# 4d. Create New Task for Member
# @name createMemberTask
POST {{baseUrl}}/tasks
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "title": "Member Race Task",
  "project_id": "{{projectId}}",
  "assigned_to": "{{memberId}}"
}

###
@mTaskId = {{createMemberTask.response.body.data.id}}
@mv1 = {{createMemberTask.response.body.data.version}}

# 4e. Admin Updates Task (Bumps Version)
# @name adminInterference
PATCH {{baseUrl}}/tasks/{{mTaskId}}
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "priority": "high",
  "version": {{mv1}}
}

###
@mv2 = {{adminInterference.response.body.data.version}}

# 4f. Member tries to update status with OLD version (Should Fail)
PATCH {{baseUrl}}/tasks/{{mTaskId}}/status
Authorization: Bearer {{memberToken}}
Content-Type: application/json

{
  "status": "in_progress",
  "version": {{mv1}}
}

###
# 4g. Member updates status with NEW version (Should Succeed)
PATCH {{baseUrl}}/tasks/{{mTaskId}}/status
Authorization: Bearer {{memberToken}}
Content-Type: application/json

{
  "status": "in_progress",
  "version": {{mv2}}
}
