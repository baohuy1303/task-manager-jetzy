{
  "name": "task-manager-jetzy",
  "version": "1.0.0",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate:create": "node-pg-migrate create",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "db:rebuild": "node tests/reset-database.js --force --full && npm run migrate:up && node tests/seed-database.js",
    "test:full": "node tests/run-all-tests.js"
  },
  "dependencies": {
    "@faker-js/faker": "^10.2.0",
    "axios": "^1.13.2",
    "bcrypt": "^6.0.0",
    "bull": "^4.16.5",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "node-pg-migrate": "^8.0.4",
    "nodemailer": "^7.0.12",
    "pg": "^8.17.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.11"
  }
}
